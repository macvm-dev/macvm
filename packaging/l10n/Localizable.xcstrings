        }
      }
    },
    "%@'s login user is unknown, so the host name and time zone can't be set over SSH" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不知道 %@ 的登录用户，无法经 SSH 设置主机名与时区"
          }
        }
      }
    },
    "%@. Until you change it back, this session can't be suspended" : {
