        }
      }
    },
    "Share name must be 1 to %lld bytes: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share name must be 1 to %1$lld bytes: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享名称应为 1 到 %lld 字节：%@"
          }
        }
      }
    },
    "Shared Folders" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享目录"
          }
        }
      }
    },
    "Shared folder as host-path[:tag][:ro] (repeatable)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享目录，格式为 主机路径[:tag][:ro]（可重复）。"
          }
        }
      }
    },
    "Shared folder doesn't exist: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享目录不存在：%@"
          }
        }
      }
