          }
        }
      }
    },
    "%@ was removed from the guest, but QEMU is still holding the file; shut down the virtual machine before attaching or changing it again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已从客户机移除，但 QEMU 仍占用着这个文件；要再次接入或改动它，先关闭虚拟机"
          }
        }
      }
    },
    "%@ was suspended, but its background process didn't exit" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已挂起，但它的后台进程没有退出"
