    },
    "Automatic" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动安装"
          }
        }
      }
    },
    "Bridged Networking" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接网络"
          }
        }
      }
    },
    "Bridged networking connects the guest directly to your Mac's local network. To use it, enable the network helper in Settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接网络让客户机直接接入 Mac 所在的局域网。要使用它，先在设置里启用网络辅助程序"
          }
        }
      }
    },
    "Bridged networking needs a fixed MAC address" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接网络需要固定的 MAC 地址"
          }
        }
      }
    },
    "Bridged networking needs the network helper. Turn it on in MacVM Settings; the first time, also allow MacVM in System Settings › General › Login Items & Extensions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接网络需要网络辅助程序。在 MacVM 的设置里启用它；第一次启用时，还要在「系统设置 › 通用 › 登录项与扩展」里允许 MacVM。"
          }
        }
      }
    },
    "Bridged networking puts virtual machines directly on your Mac's local network, where they get addresses from the router. To send and receive network traffic, it needs a network helper that runs with administrator privileges. After you enable it, allow MacVM in System Settings › General › Login Items & Extensions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接网络让虚拟机直接接入 Mac 所在的局域网，从路由器获取地址。收发网络流量需要一个以管理员权限运行的网络辅助程序。启用后，在「系统设置 › 通用 › 登录项与扩展」里允许 MacVM。"
          }
        }
      }
    },
    "Bridged: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接：%@"
          }
        }
      }
    },
    "Bridged: %@ (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bridged: %1$@ (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接：%@（%@）"
          }
        }
      }
    },
    "Bring a running VM's guest agent and guest settings up to date with this version of the app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把运行中虚拟机的客户机代理和客户机设置更新到与本 App 版本一致。"
          }
        }
      }
    },
    "CPU" : {
      "shouldTranslate" : false
    },
    "Can't delete snapshots while a task is in progress" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务进行中不能删除快照"
          }
        }
      }
    },
    "Can't move %@ into the app because its background process can't suspend it. Shut it down and start it here to see its screen" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的后台进程无法挂起它，所以不能移到 App 里。要看到画面，先关机，再在这里启动"
          }
        }
      }
    },
    "Can't restore snapshots while a task is in progress" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务进行中不能还原快照"
          }
        }
      }
    },
    "Can't suspend while disk images are attached; eject them first" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接入了磁盘映像时不能挂起，先推出它们"
          }
        }
      }
    },
    "Can't switch engines until installation finishes" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装尚未完成，不能切换引擎"
          }
        }
      }
    },
    "Can't take snapshots while a task is in progress" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务进行中不能创建快照"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Cancel Copy" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消复制"
          }
        }
      }
    },
    "Cancel Creation" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消创建"
          }
        }
      }
    },
    "Canceling…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在取消…"
          }
        }
      }
    },
    "Capture the guest's main screen as a PNG." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把客户机的主屏幕截成 PNG。"
          }
        }
      }
    },
    "Change the configuration of a stopped VM." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改已停止虚拟机的配置。"
          }
        }
      }
    },
    "Changes system settings in the guest over SSH, starting the VM if it isn't running. Steps:\n  spotlight     Turn off Spotlight indexing (Finder and Spotlight can no longer search file contents)\n  sleep         Turn off system sleep, disk sleep, and Power Nap (the display still sleeps)\n  screensaver   Turn off the screen saver\n  updates       Turn off automatic checking, downloading, and installing of system updates\n  animations    Turn off window and Dock animations\n  transparency  Turn on Reduce Transparency and Reduce Motion; if SSH doesn't have Full Disk Access, this fails\n                and you need to turn them on in the guest under System Settings > Accessibility > Display\nspotlight, sleep, and updates need sudo, which uses the guest password saved in the VM bundle (every VM created with macvm create --os macos has one).\n--revert restores the selected steps to system defaults." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经 SSH 修改客户机里的系统设置，虚拟机未运行时会先开机。各项：\n  spotlight     关闭聚焦索引（访达和聚焦不能再搜索文件内容）\n  sleep         关闭系统睡眠、磁盘睡眠和 Power Nap（显示器仍会睡眠）\n  screensaver   关闭屏幕保护程序\n  updates       关闭自动检查、下载和安装系统更新\n  animations    关闭窗口和程序坞动画\n  transparency  打开「降低透明度」和「减弱动态效果」；SSH 没有完全磁盘访问权限时会失败，\n                需要在客户机的「系统设置 > 辅助功能 > 显示」里手动打开\nspotlight、sleep 和 updates 需要 sudo，会用虚拟机包里保存的客户机密码（用 macvm create --os macos 创建的虚拟机都有）。\n--revert 把所选各项恢复为系统默认。"
          }
        }
      }
    },
    "Changing a location doesn't move existing files. The macvm command uses the new location too." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改位置不会移动已有文件。macvm 命令也会使用新位置。"
          }
        }
      }
    },
    "Check for Updates Automatically" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动检查更新"
          }
        }
      }
    },
    "Check for Updates…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查更新…"
          }
        }
      }
    },
    "Check which features this Mac supports and this build of macvm is signed for." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查这台 Mac 支持哪些功能，以及当前 macvm 的签名允许哪些功能。"
          }
        }
      }
    },
    "Choose" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择"
          }
        }
      }
    },
    "Choose either a cloud image or a desktop edition, not both" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云镜像与桌面版只能选一个"
