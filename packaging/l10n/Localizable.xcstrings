    "Microsoft refused the Windows download request (%@). This often happens after several download requests from the same network in a short time, or when a VPN or proxy is on. Try again later (it may take a few hours). %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Microsoft refused the Windows download request (%1$@). This often happens after several download requests from the same network in a short time, or when a VPN or proxy is on. Try again later (it may take a few hours). %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微软拒绝了 Windows 下载请求（%@）。同一网络短时间内多次请求下载，或开着 VPN、代理时，常会这样。请过一段时间再试（可能要几个小时）。%@"
          }
        }
      }
    },
