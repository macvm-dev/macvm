            "state" : "translated",
            "value" : "设置…"
          }
        }
      }
    },
    "Share folders from your Mac so the guest sees the same files." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把主机上的文件夹共享给客户机，两边看到同一份文件。"
          }
        }
      }
    },
    "Share folders from your Mac so the guest sees the same files. You can also drag folders here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把主机上的文件夹共享给客户机，两边看到同一份文件。也可以把文件夹拖到这里。"
          }
        }
      }
    },
    "Share name already in use: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享名称已被占用：%@"
