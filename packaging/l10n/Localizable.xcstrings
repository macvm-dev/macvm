        }
      }
    },
    "Allocate a pseudo-terminal (needed for interactive programs)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分配伪终端（交互程序需要）。"
