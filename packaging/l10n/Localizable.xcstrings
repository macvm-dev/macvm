    "%@ doesn't support shared folders; only macOS and Linux guests using the vz engine do" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不支持共享目录，只有使用 vz 引擎的 macOS 和 Linux 客户机才支持"
          }
        }
      }
    },
    "%@ exited with code %d" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ exited with code %2$d"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已退出，退出码 %d"
          }
        }
      }
    },
    "%@ has no USB controller, so you can't attach disk images to it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有 USB 控制器，不能接入磁盘映像"
          }
        }
      }
    },
    "%@ has no display device" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有显示设备"
          }
        }
      }
    },
    "%@ has the 3D graphics driver installed and needs the QEMU that comes with MacVM (macOS 27 or later); this QEMU has no 3D support, so Windows would crash at startup" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 装了 3D 显卡驱动，需要 MacVM 自带的 QEMU（macOS 27 或更高版本）；当前的 QEMU 不支持 3D，Windows 会在开机时崩溃"
          }
        }
      }
    },
    "%@ has the 3D graphics driver installed, so it can only use the qemu engine; VZ has no 3D support, and Windows would crash at startup" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 装了 3D 显卡驱动，只能用 qemu 引擎：VZ 不支持 3D，Windows 会在开机时崩溃"
          }
        }
      }
    },
