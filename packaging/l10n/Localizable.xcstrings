    "no reason given" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未说明原因"
          }
        }
      }
    },
    "npx wasn't found. Install Node.js (https://nodejs.org), then choose Install Agent Skill… again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 npx。请先安装 Node.js（https://nodejs.org），再选一次「安装 Agent 技能…」。"
          }
        }
      }
    },
    "set-value requires --value" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "set-value 需要 --value"
          }
        }
      }
    },
    "snapshot %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快照 %@"
          }
        }
      }
    },
    "snapshot lists the accessibility tree of the frontmost app, or of the app given with --app. Each element gets a number you can pass to act and click --element; the numbers stay valid until the next snapshot.\nCoordinates are always pixels in the ui screenshot image, measured from the top-left corner of the main screen.\nOn macOS guests, MacVM Agent needs Accessibility and Screen Recording permission in System Settings › Privacy & Security, or commands fail with permission_denied. Linux guests need a logged-in graphical session." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "snapshot 列出最前面的 App（或 --app 指定的 App）的无障碍树。每个元素有一个编号，可传给 act 和 click --element，编号在下一次 snapshot 前有效。\n坐标一律是 ui screenshot 截图中的像素，从主屏幕左上角算起。\n在 macOS 客户机上，MacVM Agent 需要在「系统设置 › 隐私与安全性」里获得辅助功能和屏幕录制权限，否则命令会以 permission_denied 失败。Linux 客户机需要已登录的图形会话。"
          }
        }
      }
    },
    "the guest agent disconnected" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理已断开"
          }
        }
      }
    },
