    "An earlier QEMU process for %@ is still running; quit it first (look for qemu-system-aarch64 with -name %@ in ps)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An earlier QEMU process for %1$@ is still running; quit it first (look for qemu-system-aarch64 with -name %2$@ in ps)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
