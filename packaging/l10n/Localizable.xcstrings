        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择…"
          }
        }
      }
    },
    "Click a point or the center of an element." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在坐标或元素中心点击。"
