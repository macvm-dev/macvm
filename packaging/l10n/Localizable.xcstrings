    "General" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用"
          }
        }
      }
    },
    "Generate an ssh config so you can connect to each VM with `ssh <name>`." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成 ssh 配置，之后用 `ssh <名称>` 就能连接各台虚拟机。"
          }
        }
      }
    },
    "Give at least one source and a destination" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少要有一个来源和一个目标"
          }
        }
      }
    },
    "Give either x and y coordinates or --element, not both" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给出 x、y 坐标或 --element，不能同时给出"
