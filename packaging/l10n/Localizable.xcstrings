    },
    "%@ is still being created, or its creation was interrupted, so it can't start. Wait for MacVM to finish, or resume or discard the creation in MacVM." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还在创建中，或创建已中断，所以不能开机。等 MacVM 创建完成，或在 MacVM 里继续或放弃这次创建。"
          }
        }
      }
    },
    "%@ is suspended. Resume it and shut it down before making changes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已挂起。先继续运行再关机，然后才能修改。"
          }
        }
      }
    },
    "%@ is up to date" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已是最新"
          }
        }
      }
    },
    "%@ isn't a complete ISO 9660 image" : {
