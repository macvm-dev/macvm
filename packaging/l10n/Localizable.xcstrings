    },
    "Template name (default: the VM name)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板名称（默认与虚拟机同名）。"
          }
        }
      }
    },
    "Template name." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板名称。"
          }
        }
      }
    },
    "Template not found" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板不存在"
          }
        }
      }
    },
    "Template not found: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板不存在：%@"
          }
        }
      }
    },
    "Template: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板：%@"
          }
        }
      }
    },
    "Templates" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板"
          }
        }
      }
    },
    "Templates folder: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板目录：%@"
          }
        }
      }
    },
    "Text to type." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要输入的文本。"
          }
        }
      }
    },
    "The 3D graphics driver was also updated; restarting the guest" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3D 显卡驱动也已更新，正在重启客户机"
          }
        }
      }
    },
    "The ISO doesn't contain sources/install.wim (install.esd isn't supported)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ISO 中没有 sources/install.wim（不支持 install.esd 格式的镜像）"
          }
        }
      }
    },
    "The Operation Couldn't Be Completed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成操作"
          }
        }
      }
    },
    "The QEMU engine can't attach ASIF images" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QEMU 引擎不能接入 ASIF 映像"
          }
        }
      }
    },
    "The QEMU engine doesn't support shared folders" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QEMU 引擎不支持共享目录"
          }
        }
      }
    },
    "The QEMU engine doesn't support shared folders; remove %@'s shared folders first" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QEMU 引擎不支持共享目录，请先移除 %@ 的共享目录"
          }
        }
      }
    },
    "The QEMU engine doesn't support virtio-fs shared folders on macOS" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QEMU 引擎在 macOS 上不支持 virtio-fs 共享目录"
          }
        }
      }
    },
    "The QEMU engine doesn't support vmnet networking" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QEMU 引擎不支持 vmnet 网络"
          }
        }
      }
    },
    "The QEMU engine needs QEMU; install it with brew install qemu" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QEMU 引擎需要 QEMU，请用 brew install qemu 安装"
          }
        }
      }
    },
    "The SHA-256 checksum of %@ doesn't match the published one, so the file was deleted; try again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 SHA-256 校验和与发布值不符，文件已删除，请重试"
          }
        }
      }
    },
    "The Ubuntu installer's GRUB configuration is too short to fit the autoinstall boot entry" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuntu 安装盘的 GRUB 配置太短，放不下自动安装的启动项"
          }
        }
      }
    },
    "The VM process didn't exit after suspending" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂起后虚拟机进程没有退出"
          }
        }
      }
    },
    "The VM stopped unexpectedly: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机异常停止：%@"
          }
        }
      }
    },
    "The VZ engine doesn't support screenshots" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VZ 引擎不支持截屏"
          }
        }
      }
    },
    "The agent handles exec, port forwarding, shutdown, time sync, the clipboard, and UI automation (macvm ui). Linux and macOS guests on VZ reach it over vsock, which works without guest networking; Windows and Linux guests on QEMU use TCP. It's installed automatically in macOS VMs, VMs created from cloud images, automatically installed Ubuntu Desktop, and Windows VMs set up by the installer." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理负责 exec、端口转发、关机、时间同步、剪贴板与 UI 自动化（macvm ui）。VZ 下的 Linux 与 macOS 客户机经 vsock 连接代理，不依赖客户机网络；Windows 客户机和 QEMU 下的 Linux 客户机经 TCP 连接。macOS 虚拟机、用云镜像创建的虚拟机、自动安装的 Ubuntu 桌面版，以及由安装程序部署的 Windows 虚拟机都会自动安装代理。"
          }
        }
      }
    },
    "The app bundles a different agent version; run macvm agent install %@ to update" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 App 自带的代理版本不同，请运行 macvm agent install %@ 更新"
          }
        }
      }
    },
    "The background process logs to run.log inside the VM bundle." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台进程的日志写在虚拟机包内的 run.log。"
          }
        }
      }
    },
    "The bundle for %@ has no shared token, so the guest agent can't be reached over bridged networking; reinstall it with macvm agent install %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The bundle for %1$@ has no shared token, so the guest agent can't be reached over bridged networking; reinstall it with macvm agent install %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的包里没有共享令牌，无法通过桥接网络连接客户机代理；请用 macvm agent install %@ 重新安装"
          }
        }
      }
    },
    "The bundled QEMU can't suspend with 3D graphics (virgl) on; shut down instead" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 自带的 QEMU 在开启 3D 显卡（virgl）时不能挂起，请改为关机"
          }
        }
      }
    },
    "The control connection was closed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制连接已关闭"
          }
        }
      }
    },
    "The copied files (%@) are too large to paste into the virtual machine. Drag them into its window instead" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制的文件（%@）太大，无法粘贴到虚拟机。请直接拖进虚拟机窗口"
          }
        }
      }
    },
    "The disk is already at its maximum size of %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘已达到最大容量 %@。"
          }
        }
      }
    },
    "The download and template folders can't be changed while downloading, installing, or saving a template." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在下载、安装或存模板时不能更改下载目录与模板目录。"
          }
        }
      }
    },
    "The driver package doesn't contain viogpu3d.inf: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驱动包里没有 viogpu3d.inf：%@"
          }
        }
      }
    },
    "The file is too large to copy (%@)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件太大，无法复制（%@）"
          }
        }
      }
    },
    "The guest agent closed the connection" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理关闭了连接"
          }
        }
      }
    },
    "The guest agent closed the connection while installing the graphics driver" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理在安装显卡驱动时关闭了连接"
          }
        }
      }
    },
    "The guest agent disconnected before the copy finished" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制完成前客户机代理断开了连接"
          }
        }
      }
    },
    "The guest agent disconnected in the middle of a message" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理在一条消息传到一半时断开了连接"
          }
        }
      }
    },
    "The guest agent disconnected unexpectedly" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理意外断开"
          }
        }
      }
    },
    "The guest agent in %@ didn't send an authentication challenge and may be out of date; update it with macvm agent install %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The guest agent in %1$@ didn't send an authentication challenge and may be out of date; update it with macvm agent install %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机代理没有发来认证质询，可能是旧版代理，用 macvm agent install %@ 更新"
          }
        }
      }
    },
    "The guest agent in %@ disconnected without sending an authentication challenge. Either the agent isn't running or the guest has no shared token; reinstall it with macvm agent install %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The guest agent in %1$@ disconnected without sending an authentication challenge. Either the agent isn't running or the guest has no shared token; reinstall it with macvm agent install %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机代理没有发来认证质询就断开了。可能是代理没有运行，或客户机里没有共享令牌；请用 macvm agent install %@ 重新安装。"
          }
        }
      }
    },
    "The guest agent in %@ is too old for UI automation; update it with macvm agent install %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The guest agent in %1$@ is too old for UI automation; update it with macvm agent install %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机代理版本过旧，不支持 UI 自动化，先运行 macvm agent install %@ 更新"
          }
        }
      }
    },
    "The guest agent in %@ is too old to copy files; update it with macvm agent install %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The guest agent in %1$@ is too old to copy files; update it with macvm agent install %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机代理版本过旧，不支持复制文件，先运行 macvm agent install %@ 更新"
          }
        }
      }
    },
    "The guest agent isn't installed in %@; install it to apply screen lock settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未安装客户机代理，装上代理后才能应用锁屏设置"
          }
        }
      }
    },
    "The guest agent isn't installed in %@; run macvm agent install %@ first" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The guest agent isn't installed in %1$@; run macvm agent install %2$@ first"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有安装客户机代理，先运行 macvm agent install %@"
          }
        }
      }
    },
    "The guest agent on %@ already matches the app's version; add --ssh to reinstall" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机代理已是 App 自带的版本；要重装请加 --ssh"
          }
        }
      }
    },
    "The guest agent on %@ didn't respond within %lld seconds" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The guest agent on %1$@ didn't respond within %2$lld seconds"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机代理 %lld 秒内未响应"
          }
        }
      }
    },
    "The guest agent returned no info" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理未返回信息"
          }
        }
      }
    },
    "The guest agent sent a message that's too large (%lld bytes)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理发来的消息过大（%lld 字节）"
          }
        }
      }
    },
    "The guest agent sent an invalid file stream" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理发来无效的文件流"
          }
        }
      }
    },
    "The guest agent sent an invalid file stream: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理发来无效的文件流：%@"
          }
        }
      }
    },
    "The guest agent sent an invalid frame" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理发来无效帧"
          }
        }
      }
    },
    "The guest agent was updated, but the new version didn't respond within %lld seconds" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机代理已更新，但新版本在 %lld 秒内没有响应"
          }
        }
      }
    },
    "The guest destination must be a directory path, such as %@:/tmp" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机目标必须是目录路径，如 %@:/tmp"
          }
        }
      }
    },
    "The guest didn't shut down after installing" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装完成后客户机未关机"
          }
        }
      }
    },
    "The guest didn't shut down after the installation finished" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装完成后客户机未关机"
          }
        }
      }
    },
    "The guest didn't shut down within %lld seconds; use --force to power it off" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机在 %lld 秒内未关机，可用 --force 强制断电"
          }
        }
      }
    },
    "The guest display is asleep. Move the mouse or press any key to wake it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机显示器正在休眠。移动鼠标或按任意键唤醒"
          }
        }
      }
    },
    "The guest expands its root partition and file system to the new size the next time it starts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次开机时客户机自动把根分区和文件系统扩展到新容量。"
          }
        }
      }
    },
    "The guest hasn't granted the agent a required permission" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机未授予代理所需的权限"
          }
        }
      }
    },
    "The guest isn't showing anything right now (its display is asleep, or it's still on the firmware screen during startup); wake it and try again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机现在没有画面输出（显示器在休眠，或开机时仍停在固件画面），请唤醒后重试"
          }
        }
      }
    },
    "The guest may be waiting for you to save a document or confirm the shutdown. You can handle it in the virtual machine's window and keep waiting. Powering off loses any unsaved work in the guest." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机可能在等你保存文档或确认关机，你可以在虚拟机窗口里处理，然后继续等待。强制断电会丢失客户机里未保存的内容。"
          }
        }
      }
    },
    "The helper will be turned off and back on. Virtual machines using bridged networking will lose their network connection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络辅助程序会先关闭再重新打开。使用桥接网络的虚拟机会断开网络连接。"
          }
        }
      }
    },
    "The image archive doesn't contain a .%@ disk" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镜像归档里没有 .%@ 磁盘"
          }
        }
      }
    },
    "The login user name or virtual machine name has characters that ssh can't accept: %@@%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The login user name or virtual machine name has characters that ssh can't accept: %1$@@%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录用户名或虚拟机名包含 ssh 不接受的字符：%@@%@"
          }
        }
      }
    },
    "The microphone will be connected at the next startup" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次开机时接上麦克风"
          }
        }
      }
    },
    "The microphone will be disconnected at the next startup" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次开机时断开麦克风"
          }
        }
      }
    },
    "The network helper isn't responding; turn it off and on again in MacVM Settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络辅助程序没有响应，请在 MacVM 设置中将它关闭后重新打开"
          }
        }
      }
    },
    "The new language takes effect after MacVM restarts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新语言在 MacVM 重新启动后生效。"
          }
        }
      }
    },
    "The new size (%@) must be larger than the current size (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The new size (%1$@) must be larger than the current size (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新大小（%@）必须大于当前大小（%@）"
          }
        }
      }
    },
    "The new size lasts until the VM shuts down. Omit the size to go back to the default, which you can change with macvm set --display. Windows on VZ has a fixed resolution and can't be resized." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新尺寸在虚拟机关机前一直有效。省略尺寸会恢复默认尺寸，默认尺寸可用 macvm set --display 修改。VZ 下的 Windows 分辨率固定，不能调整。"
          }
        }
      }
    },
    "The number of bridges doesn't match the number of network adapters in the configuration" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接数量与配置里的网卡数量不符"
          }
        }
      }
    },
    "The password is saved to guest-password in the virtual machine bundle, which only you can read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码保存在虚拟机包内的 guest-password，只有你能读。"
          }
        }
      }
    },
    "The product key must be 25 letters or digits (XXXXX-XXXXX-XXXXX-XXXXX-XXXXX)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "产品密钥应为 25 个字母或数字（XXXXX-XXXXX-XXXXX-XXXXX-XXXXX）"
          }
        }
      }
    },
    "The server returned HTTP %@ while checking range request support (%@). The data downloaded so far was kept; try again later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The server returned HTTP %1$@ while checking range request support (%2$@). The data downloaded so far was kept; try again later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查服务器是否支持范围请求时，服务器返回 HTTP %@（%@）。已下载的数据已保留，请稍后重试。"
          }
        }
      }
    },
    "The shared folder path is empty" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享目录路径为空"
          }
        }
      }
    },
    "The sources and the destination can't both be on the guest" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源和目标不能都在客户机上"
          }
        }
      }
    },
    "The sources must all be on the same VM" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源必须都在同一台虚拟机上"
          }
        }
      }
    },
    "The suspended state is saved, so any that didn't start in the background will resume at the next start." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂起状态已保存，没能在后台启动的虚拟机会在下次开机时继续运行。"
          }
        }
      }
    },
    "The user name %@ is reserved by the system; choose another" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名 %@ 已被系统保留，请换一个"
          }
        }
      }
    },
    "The virtual machine folder can't be changed while a virtual machine is running or being created." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有虚拟机正在运行或创建时，不能更改虚拟机目录。"
          }
        }
      }
    },
    "The virtual machine folder is set by the MACVM_HOME environment variable." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机目录由环境变量 MACVM_HOME 指定。"
          }
        }
      }
    },
    "The virtual machine has no vsock device" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机没有 vsock 设备"
          }
        }
      }
    },
    "The virtual machine stopped unexpectedly during installation; see the log at %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装过程中虚拟机意外停止，日志：%@"
          }
        }
      }
    },
    "Then you can run ssh %@ directly. MacVM adds a single Include line and changes nothing else." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后可以直接运行 ssh %@。MacVM 只会加一行 Include，不改动其他内容。"
          }
        }
      }
    },
    "This Mac" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机"
          }
        }
      }
    },
    "This Mac doesn't support Rosetta for Linux" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机不支持 Linux 版 Rosetta"
          }
        }
      }
    },
    "This Mac doesn't support the virtual machine's hardware model; update macOS on this Mac" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机不支持该虚拟机的硬件型号，请更新本机的 macOS"
          }
        }
      }
    },
    "This Mac doesn't support virtualization" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机不支持虚拟化"
          }
        }
      }
    },
    "This Mac doesn't support virtualization (it needs Apple silicon and an app signed with the com.apple.security.virtualization entitlement)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机不支持虚拟化（需要 Apple 芯片，且 App 的签名带有 com.apple.security.virtualization 权限）"
          }
        }
      }
    },
    "This Mac has no bridgeable network interface" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机没有可桥接的网卡"
          }
        }
      }
    },
    "This can't be undone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除后无法恢复。"
          }
        }
      }
    },
    "This folder is already shared: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该目录已共享：%@"
          }
        }
      }
    },
    "This version of macOS can't run Windows with the vz engine" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前版本的 macOS 不能用 vz 引擎运行 Windows"
          }
        }
      }
    },
    "This version of macOS doesn't support Windows guests" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 macOS 不支持运行 Windows 客户机"
          }
        }
      }
    },
    "This virtual machine was started with macvm start and is running in another process. Only the process running a VZ virtual machine can show its screen, and this one can't be suspended to move it here. Shut it down, then start it again here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台虚拟机是用 macvm start 启动的，在另一个进程里运行。VZ 虚拟机的画面只能由运行它的进程显示，而这台虚拟机不能挂起，无法转到这里运行。请将它关机，再在这里重新开机。"
          }
        }
      }
    },
    "This virtual machine's configuration doesn't support suspending" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该虚拟机的配置不支持挂起"
          }
        }
      }
    },
    "Timed out" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已超时"
          }
        }
      }
    },
    "Timed out connecting to %@:%u" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timed out connecting to %1$@:%2$u"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 %@:%u 超时"
          }
        }
      }
    },
    "Timed out connecting to the QEMU control interface" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 QEMU 控制接口超时"
          }
        }
      }
    },
    "Timed out waiting for %@ to start; see the log at %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timed out waiting for %1$@ to start; see the log at %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待 %@ 启动超时，日志：%@"
          }
        }
      }
    },
    "To change the virtual machine folder, first resume or discard the interrupted creation in the list." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要更改虚拟机目录，请先在列表里继续或放弃被中断的创建。"
          }
        }
      }
    },
    "To finish transparency, turn on Reduce Transparency and Reduce Motion yourself in the guest under System Settings > Accessibility > Display" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要完成 transparency 项，请在客户机的「系统设置 › 辅助功能 › 显示」里手动打开「降低透明度」和「减弱动态效果」"
          }
        }
      }
    },
    "To make a template, choose Save as Template… from a virtual machine's More Actions menu. You can then create virtual machines from it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要制作模板，请在虚拟机的「更多操作」菜单里选择「存为模板…」。之后就可以用它新建虚拟机。"
          }
        }
      }
    },
    "To mount it in the Linux guest, run: sudo mkdir -p /mnt/%@ && sudo mount -t virtiofs %@ /mnt/%@. To mount it at startup, add it to /etc/fstab." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To mount it in the Linux guest, run: sudo mkdir -p /mnt/%1$@ && sudo mount -t virtiofs %2$@ /mnt/%3$@. To mount it at startup, add it to /etc/fstab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在 Linux 客户机里挂载，请运行：sudo mkdir -p /mnt/%@ && sudo mount -t virtiofs %@ /mnt/%@。要开机自动挂载，请把它加入 /etc/fstab。"
          }
        }
      }
    },
    "Treat the hardware clock as UTC and allow only key-based SSH" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把硬件时钟当作 UTC，SSH 只允许密钥登录"
          }
        }
      }
    },
    "Tune a macOS guest to reduce idle CPU, disk, and memory usage." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调优 macOS 客户机，降低空闲时的 CPU、磁盘与内存占用。"
          }
        }
      }
    },
    "Tuned %@: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tuned %1$@: %2$@"
