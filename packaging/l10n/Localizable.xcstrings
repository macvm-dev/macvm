    "%@'s login user is unknown, so it can't be tuned over SSH" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不知道 %@ 的登录用户，无法经 SSH 调优"
