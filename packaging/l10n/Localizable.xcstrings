    "Shut down a VM." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭虚拟机。"
          }
        }
      }
    },
    "Shut down or suspend the virtual machine to restore a snapshot" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先关机或挂起虚拟机，才能还原快照"
          }
        }
      }
    },
    "Shut down or suspend the virtual machine to take a snapshot" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先关机或挂起虚拟机，才能创建快照"
          }
        }
      }
    },
    "Shut down the virtual machine to add folders" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关机后才能添加共享目录"
          }
        }
      }
    },
    "Shut down to change processors, memory, network, sound, microphone, and disk size." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关机后可修改处理器、内存、网络、声音、麦克风与磁盘容量。"
          }
        }
      }
    },
    "Shutting down…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在关机…"
          }
        }
      }
    },
    "Size in pixels as WIDTHxHEIGHT, e.g. 2560x1600. Omit to use the default." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以像素为单位的尺寸，格式为 宽x高，如 2560x1600。省略时用默认尺寸。"
          }
        }
      }
    },
    "Size must be WIDTHxHEIGHT, e.g. 2560x1600" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尺寸格式应为 宽x高，如 2560x1600"
          }
        }
      }
    },
    "Skip a step (repeatable)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
