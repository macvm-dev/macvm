          }
        }
      }
    },
    "Another process is already downloading %@; waiting for it to finish…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个进程正在下载 %@，等待它完成…"
          }
        }
      }
    },
    "Any changes that aren't saved in a snapshot will be lost." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前未保存为快照的改动会丢失。"
          }
        }
      }
    },
    "App to inspect: pid, process name, or (on macOS) bundle ID. Defaults to the frontmost app." : {
      "localizations" : {
