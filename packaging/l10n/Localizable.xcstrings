{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    " %@ can't move to the background and will be suspended." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能转到后台，会挂起。"
          }
        }
      }
    },
    " %@ can't move to the background and will shut down normally." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能转到后台，会正常关机。"
          }
        }
      }
    },
    " Only the process running a VZ virtual machine can show its screen, so to see it again, shut it down and start it in MacVM." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VZ 虚拟机的画面只能由运行它的进程显示，要重新看到画面，先关机，再在 MacVM 里启动。"
          }
        }
      }
    },
    " · Includes memory" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · 含内存"
          }
        }
      }
    },
    "%@ (cloud image, no install needed)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（云镜像，免安装）"
          }
        }
      }
    },
    "%@ (download installer)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（下载安装盘）"
          }
        }
      }
    },
    "%@ (shut down; start it with macvm start %@ or in the app, then reconnect)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (shut down; start it with macvm start %2$@ or in the app, then reconnect)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（已关机，用 macvm start %@ 或在 App 里开机后再连）"
          }
        }
      }
    },
    "%@ (shut it down or suspend it before taking a snapshot)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（先关机或挂起，再创建快照）"
          }
        }
      }
    },
    "%@ Suspend and resume" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 挂起与继续运行"
          }
        }
      }
    },
    "%@ Virtualization (Apple Silicon + com.apple.security.virtualization)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 虚拟化（Apple Silicon + com.apple.security.virtualization）"
          }
        }
      }
    },
    "%@ Windows guests on VZ (Virtualization.framework PMU emulation)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Windows 客户机用 VZ 运行（Virtualization.framework PMU 模拟）"
          }
        }
      }
    },
    "%@ can't be suspended. MacVM waits for the guest to shut down before quitting." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能挂起。MacVM 会等客户机关机后再退出。"
          }
        }
      }
    },
    "%@ can't be used with --template: the OS, accounts, and devices all come from the template" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能与 --template 同用：系统、账户与设备都沿用模板"
          }
        }
      }
    },
    "%@ disk" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 磁盘"
