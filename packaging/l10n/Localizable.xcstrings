          }
        }
      }
    },
    "Disks can grow but can't shrink. The image uses space on the Mac only as data is written, so growing it doesn't take up any extra space by itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘只能扩大，不能缩小。镜像只在写入数据时占用 Mac 上的空间，所以扩容本身不会多占空间。"
          }
        }
