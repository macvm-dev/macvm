Return guest pages reported free through virtio-balloon free page reporting to macOS
under HVF. madvise() does not release pages the guest has written through the stage-2
mapping, so each reported range is unmapped from the guest, replaced with fresh anonymous
memory and mapped back; the guest reads zeroes there afterwards.

--- a/accel/hvf/hvf-all.c
+++ b/accel/hvf/hvf-all.c
@@ -136,6 +136,35 @@
     assert_hvf_ok(ret);
 }
 
+/*
+ * madvise() does not release pages the guest has written through the
+ * stage-2 mapping on macOS, so the range is unmapped from the guest, replaced
+ * with fresh anonymous memory and mapped back.
+ */
+bool hvf_discard_guest_ram(uint64_t gpa, void *host, size_t size)
+{
+    hv_memory_flags_t flags = HV_MEMORY_READ | HV_MEMORY_WRITE | HV_MEMORY_EXEC;
+    uint64_t page_size = qemu_real_host_page_size();
+    hv_return_t ret;
+
+    if (!QEMU_IS_ALIGNED(gpa | size, page_size) ||
+        !QEMU_PTR_IS_ALIGNED(host, page_size) || !size) {
+        return false;
+    }
+    ret = hv_vm_unmap(gpa, size);
+    if (ret != HV_SUCCESS) {
+        return false;
+    }
+    if (mmap(host, size, PROT_READ | PROT_WRITE,
+             MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0) == MAP_FAILED) {
+        /* A failed MAP_FIXED mmap leaves the old mapping in place. */
+        assert_hvf_ok(hv_vm_map(host, gpa, size, flags));
+        return false;
+    }
+    assert_hvf_ok(hv_vm_map(host, gpa, size, flags));
+    return true;
+}
