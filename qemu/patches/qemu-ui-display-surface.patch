+++ b/ui/spice-display.c
@@ -26,6 +26,7 @@
 #include "ui/console.h"
 #include "system/system.h"
 #include "trace.h"
+#include "qapi/qapi-commands-ui.h"
 #ifdef CONFIG_IOSURFACE
 #include <TargetConditionals.h>
 #if TARGET_OS_OSX
@@ -1919,7 +1920,31 @@
     qemu_console_register_listener(con, &ssd->dcl, ops);
     g_ptr_array_add(spice_displays, ssd);
 }
+
+MacVMDisplaySurface *qmp_x_macvm_display_surface(Error **errp)
+{
+#if defined(HAVE_SPICE_GL) && defined(CONFIG_IOSURFACE)
+    for (guint i = 0; spice_displays && i < spice_displays->len; i++) {
+        SimpleSpiceDisplay *ssd = g_ptr_array_index(spice_displays, i);
+        MacVMDisplaySurface *ret;
 
+        if (qemu_console_get_index(ssd->dcl.con) != 0) {
+            continue;
+        }
+        if (!ssd->have_scanout || !ssd->iosurface) {
+            break;
+        }
+        ret = g_new0(MacVMDisplaySurface, 1);
+        ret->iosurface = IOSurfaceGetID(ssd->iosurface);
+        ret->width = IOSurfaceGetWidth(ssd->iosurface);
+        ret->height = IOSurfaceGetHeight(ssd->iosurface);
+        return ret;
+    }
+#endif
+    error_setg(errp, "the display has no GL scanout");
+    return NULL;
+}
