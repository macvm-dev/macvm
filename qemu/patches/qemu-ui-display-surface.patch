Add x-macvm-display-surface, returning the global IOSurface that holds the GL scanout of
the first console. With virgl the frame lives on the host GPU, the guest cannot read it
and screendump only sees a stale surface; a host process can read the IOSurface instead.

--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1710,8 +1710,41 @@
 ##
 { 'command': 'x-macvm-set-display-size',
   'data': { 'width': 'int', 'height': 'int' } }
+
+##
+# @MacVMDisplaySurface:
+#
+# The IOSurface holding the GL scanout of a display.
+#
+# @iosurface: global IOSurface ID, for IOSurfaceLookup in another
+#     process
+#
+# @width: width in pixels
+#
+# @height: height in pixels
+#
+# Since: 11.1
+##
+{ 'struct': 'MacVMDisplaySurface',
+  'data': { 'iosurface': 'uint32', 'width': 'int', 'height': 'int' },
+  'if': 'CONFIG_SPICE' }
 
 ##
+# @x-macvm-display-surface:
+#
+# Return the IOSurface that holds the GL scanout of the first
+# console, so that a host process can read the guest screen when the
+# frame lives on the GPU and screendump only sees a stale surface.
+#
+# Returns: the surface
+#
+# Since: 11.1
+##
+{ 'command': 'x-macvm-display-surface',
+  'returns': 'MacVMDisplaySurface',
+  'if': 'CONFIG_SPICE' }
+
+##
 # @client_migrate_info:
 #
 # Set migration information for remote display.  This makes the server
