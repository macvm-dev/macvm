+static void cs_cursor_report(CSCursor *self)
+{
+    void (^handler)(NSData *, CGSize, CGPoint);
+    NSData *pixels;
+    CGSize size;
+    CGPoint hotspot;
+    @synchronized (self) {
+        handler = self.shapeHandler;
+        pixels = self.hasCursor && !self.cursorHidden ? self.shapePixels : nil;
+        size = self.cursorSize;
+        hotspot = self.cursorHotspot;
+    }
+    if (handler) {
+        handler(pixels, size, hotspot);
+    }
+}
