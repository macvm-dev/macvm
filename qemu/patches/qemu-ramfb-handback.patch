virtio-ramfb: keep the ramfb on screen until the guest scans out a virtio-gpu
resource. The firmware's virtio-gpu driver only disables the scanout and resets
the device at ExitBootServices, while the firmware, the boot loader and the
kernel's early console draw to the ramfb.

--- a/include/hw/display/ramfb.h
+++ b/include/hw/display/ramfb.h
@@ -6,6 +6,11 @@
 /* ramfb.c */
 typedef struct RAMFBState RAMFBState;
 void ramfb_display_update(QemuConsole *con, RAMFBState *s);
+/*
+ * Rebuilds the surface from the guest's last configuration after the console
+ * has shown another one, so ramfb_display_update() puts it back.
+ */
+void ramfb_display_reattach(RAMFBState *s);
 RAMFBState *ramfb_setup(bool romfile, Error **errp);
 
 extern const VMStateDescription ramfb_vmstate;
--- a/hw/display/ramfb.c
+++ b/hw/display/ramfb.c
@@ -105,6 +105,13 @@
     s->ds = surface;
 }
 
+void ramfb_display_reattach(RAMFBState *s)
+{
+    if (!s->ds) {
+        ramfb_fw_cfg_write(s, 0, 0);
+    }
+}
+
 void ramfb_display_update(QemuConsole *con, RAMFBState *s)
 {
     if (!s->width || !s->height) {
