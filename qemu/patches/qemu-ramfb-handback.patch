+++ b/hw/display/virtio-ramfb.c
@@ -43,11 +43,29 @@
 {
     VirtIORAMFBBase *vramfb = opaque;
     VirtIOGPUBase *g = vramfb->vgpu;
+    QemuConsole *con = g->scanout[0].con;
+    DisplaySurface *surface = qemu_console_surface(con);
 
-    if (g->enable) {
+    /*
+     * The ramfb stays on screen until the guest scans out a virtio-gpu
+     * resource. The firmware's virtio-gpu driver only disables the scanout and
+     * resets the device when it exits boot services, while the firmware, the
+     * boot loader and the kernel's early console all draw to the ramfb.
+     */
+    if (!g->enable) {
+        vramfb->gpu_shown = false;
+    } else if (g->scanout[0].resource_id) {
+        vramfb->gpu_shown = true;
+    }
+    if (vramfb->gpu_shown) {
