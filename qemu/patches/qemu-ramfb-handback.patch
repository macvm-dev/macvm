-    ramfb_display_update(g->scanout[0].con, vramfb->ramfb);
+    if (vramfb->ramfb_hidden || (surface && surface_is_placeholder(surface))) {
+        vramfb->ramfb_hidden = false;
+        ramfb_display_reattach(vramfb->ramfb);
+    }
+    ramfb_display_update(con, vramfb->ramfb);
     return true;
 }
 
